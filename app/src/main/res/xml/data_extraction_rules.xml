<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!--
        The hub on/off switch (HubSwitch.kt) is this device's running state, not configuration.
        Restored onto a reinstall or a new phone, it could bring the app up silently switched off.
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="shortcut_hub_switch.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="shortcut_hub_switch.xml"/>
    </device-transfer>
</data-extraction-rules>